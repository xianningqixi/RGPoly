# Copy these into your shell environment. Do not commit real secrets.
# Current system mode: strict simulation / preflight only.
# Adding API credentials must not require strategy code changes.
# These credentials are checked by api_key_readiness_check.py but are not used
# by the simulators to place live orders.
#
# PowerShell examples:
# $env:POLY_API_KEY="..."
# $env:POLY_API_SECRET="..."
# $env:POLY_API_PASSPHRASE="..."
# $env:POLY_PROXY_ADDRESS="0x..."   # optional
# $env:POLY_SIGNATURE_TYPE="..."    # optional
# $env:PRIVATE_KEY="..."            # live execution only; never commit

POLY_PROXY_ADDRESS=
POLY_SIGNATURE_TYPE=
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=
PRIVATE_KEY=

# Real-money execution acknowledgement gates.
# Leave these unset for simulation and dry-run development.
POLY_EXECUTION_ENABLED=
POLY_WALLET_COPY_ENABLED=
POLY_CLOB_EXECUTION_ENABLED=
POLY_BTC_COPY_WORKER_ENABLED=
POLY_BTC_COPY_MONITOR_ENABLED=

# Strict simulation defaults.
POLY_STRICT_SIM_EXECUTION=1

# Optional AI decision mode. Default is local deterministic simulation logic.
# Set AI_DECISION_MODE=openai only if you want external LLM approval for simulated signals.
AI_DECISION_MODE=local
OPENAI_API_KEY=
AI_DECISION_OPENAI_MODEL=gpt-4o-mini

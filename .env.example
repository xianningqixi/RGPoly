# RGPoly v2 environment example.
# Copy values into your shell; do not commit real secrets.

# Polymarket CLOB signing key. Use a dedicated low-balance trading wallet.
PRIVATE_KEY=

# Polymarket L2 API credentials. If you only have PRIVATE_KEY, run:
# python -m rgpoly --config .\config\rgpoly.toml derive-api-key
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# New Polymarket users normally trade through a deposit/proxy wallet.
POLY_SIGNATURE_TYPE=3
POLY_PROXY_ADDRESS=

# Explicit real-money acknowledgement gate for rgpoly live mode.
# Leave unset for manual and dry-run runs.
RGPOLY_LIVE_ENABLED=
# RGPOLY_LIVE_ENABLED=I_UNDERSTAND_REAL_MONEY_RISK
